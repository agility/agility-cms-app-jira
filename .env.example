# Which provider this deployment serves. "mock" is an in-memory demo tracker: no Atlassian account needed.
# Never use "mock" on a production deployment.
WORK_PROVIDER=mock

# This app's public origin, no trailing slash. Builds the OAuth redirect (…/api/connect/callback) and the icon URLs
# Jira shows next to each remote link.
APP_URL=http://localhost:3071

# Encrypts provider tokens at rest (AES-256-GCM). 32 bytes, base64:  openssl rand -base64 32
WORK_TOKEN_KEY=

# Signs the OAuth state parameter. Defaults to WORK_TOKEN_KEY when unset.
# WORK_STATE_SECRET=

# Atlassian OAuth 2.0 (3LO) app, from developer.atlassian.com → My apps. Callback URL: ${APP_URL}/api/connect/callback.
# Scopes: read:jira-work write:jira-work read:jira-user manage:jira-webhook offline_access.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=

# Local development only: accept the token "dev" from /dev-host instead of verifying it with Agility.
# Ignored when NODE_ENV is production.
WORK_DEV_CALLER=1
